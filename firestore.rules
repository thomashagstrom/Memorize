rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can read and write only their own notes.
    match /notes/{noteId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // Any signed-in person can read profiles, for the leaderboard ranking. Nobody
    // can write one from the browser: the game's server checks each game and
    // saves the best score (the Admin SDK is not bound by these rules).
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Daily challenge scores, one per player per UTC day, read for the daily leaderboard.
    // Only the game's server writes them.
    match /dailyScores/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else is closed. Open a path here on purpose, never by default.
  }
}
